{
  "name": "mybizmanager",
  "version": "1.0.0",
  "private": true,
  "description": "Omad-D rent management and cafe POS on Google Sheets + Apps Script",
  "scripts": {
    "build": "node scripts/build-apps-script.js",
    "build:check": "node scripts/build-apps-script.js --check",
    "build:css": "tailwindcss -c tailwind.config.js -i assets/css/tailwind.src.css -o assets/css/app.css --minify",
    "build:icons": "node scripts/build-icons.js",
    "build:icons:check": "node scripts/build-icons.js --check",
    "ui:screenshots": "node scripts/ui-screenshots.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --test tests/*.e2e.js",
    "test:supabase": "node scripts/test-supabase.js",
    "test:supabase:e2e": "node scripts/test-supabase.js --e2e",
    "test:all": "npm test && npm run test:e2e",
    "lint": "node --test tests/static-analysis.test.js",
    "bench": "node scripts/bench-reads.js",
    "scan:secrets": "node scripts/scan-secrets.js",
    "scan:secrets:history": "node scripts/scan-secrets.js --history"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "tailwindcss": "^3.4.17"
  },
  "engines": {
    "node": ">=20"
  }
}
